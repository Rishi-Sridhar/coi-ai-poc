# --- Groq (live AI). Get a key at https://console.groq.com/keys
# Leave the key empty and set DEMO_MODE=true to use the labelled demo fallback.
GROQ_API_KEY=
# Default: openai/gpt-oss-120b (any Groq chat model; JSON-schema mode is used when the model supports it)
GROQ_MODEL=
DEMO_MODE=false

# --- SMTP (optional). If SMTP_HOST is empty, emails stay in the outbox as NOT_CONFIGURED.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME / SMTP_FROM_EMAIL = your Gmail address,
# SMTP_PASSWORD = a 16-character Google App Password (needs 2-Step Verification; spaces are ignored for Gmail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Where reviewer notifications are sent (e.g. your own inbox for the demo).
REVIEWER_EMAIL=
APP_BASE_URL=http://localhost:8501

# Admin page sign-in (the ONLY page that needs a login). Empty = the Admin page stays locked.
# Create a value with:  python -m coi.admin_auth
ADMIN_PASSWORD_HASH=

REVIEW_CLEAN_CASES=false

PROMPT_VERSION=v1
GUIDANCE_VERSION=v1
QUESTIONNAIRE_VERSION=v1
